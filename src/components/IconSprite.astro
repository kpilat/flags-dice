---
// Icons used as <svg><use href="#i-…"></use></svg>; one per category id, plus the flag.
---

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    {/* country: outline with a question mark */}
    <symbol
      id="i-country"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 31c1-6 7-8 11-11 4-3 8-6 13-5 3 1 5 3 9 2 4-1 7 1 9 4 2 3 6 3 8 6 2 3 0 6-3 7-3 1-4 4-7 5-3 1-5 0-8 2-3 2-6 4-10 3-3-1-4-3-7-3-3 0-6 1-9-1-3-2-7-5-6-9z"></path>
      <path d="M28.5 27a4 4 0 1 1 5.5 3.7c-1.3.6-2 1.6-2 3v.8"></path>
      <circle cx="32" cy="39.2" r="0.9" fill="currentColor"></circle>
    </symbol>
    {/* capital: city buildings */}
    <symbol
      id="i-capital"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 56h48"></path>
      <path d="M14 56V20h18v36"></path>
      <path d="M19 20v-5h8v5"></path>
      <path d="M23 15V8"></path>
      <path d="M32 56V32h18v24"></path>
      <path d="M19 26h2M25 26h2M19 32h2M25 32h2M19 38h2M25 38h2M19 44h2M25 44h2"></path>
      <path d="M37 38v12M41 38v12M45 38v12"></path>
    </symbol>
    {/* continent: globe */}
    <symbol
      id="i-continent"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="32" cy="32" r="23"></circle>
      <path d="M14 20c4 1 6 4 10 3 3-1 3 3 6 4 3 1 2 5-1 6-3 1-2 5 0 7 2 3 0 6-2 9"></path>
      <path d="M36 10c-1 3 1 5 4 5 3 0 3 3 6 3 3 0 5 2 7 4"></path>
      <path d="M41 33c3-1 6 0 7 3 1 3-1 5-3 7-2 2-3 5-5 6"></path>
    </symbol>
    {/* neighbours: country with numbered borders */}
    <symbol
      id="i-neighbors"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M16 32c1-4 5-5 8-7 2-2 5-3 8-2 3 1 6 1 9 3 3 2 6 3 7 6 0 3-3 4-5 6-3 2-6 2-9 3-3 1-6 0-9-1-3-1-6-1-8-3-1-1-1-3-1-5z"></path>
      <path d="M32 23l-2-8 4-7M48 32l7 2M32 41l-2 8M16 32l-8 3"></path>
      <g
        font-size="8"
        font-weight="600"
        fill="currentColor"
        stroke="none"
        style="font-family: var(--font-lexend)"
      >
        <text x="37" y="12">
          1
        </text>
        <text x="55" y="31">
          2
        </text>
        <text x="33" y="57">
          3
        </text>
        <text x="4" y="31">
          4
        </text>
      </g>
    </symbol>
    {/* language: speech bubbles */}
    <symbol
      id="i-language"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M30 14c-9-4-22 0-22 10 0 5 3 8 6 10l-3 7 8-4c2 1 5 1 7 1"></path>
      <path d="M40 24c9 0 16 6 16 13 0 4-2 7-5 9l2 7-7-4c-2 1-4 1-6 1-9 0-16-6-16-13s7-13 16-13z"></path>
      <path d="M37 33a3.2 3.2 0 1 1 4.4 3c-1 .4-1.4 1.2-1.4 2.2v.5"></path>
      <circle cx="40" cy="43.2" r="0.9" fill="currentColor"></circle>
    </symbol>
    {/* currency: banknote + coins */}
    <symbol
      id="i-currency"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M11 14l40-6 4 26-40 6z"></path>
      <path d="M16 18l30-4.5 2.6 17.5-30 4.5z"></path>
      <ellipse cx="32.5" cy="24.5" rx="5" ry="4" transform="rotate(-8 32.5 24.5)"></ellipse>
      <ellipse cx="18" cy="52" rx="8" ry="3"></ellipse>
      <path d="M10 52v3c0 1.7 3.6 3 8 3s8-1.3 8-3v-3"></path>
      <ellipse cx="40" cy="54" rx="7" ry="2.6"></ellipse>
    </symbol>
    <symbol
      id="i-flag"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 21V4"></path>
      <path d="M5 4c4-2 7 2 11 0v9c-4 2-7-2-11 0"></path>
    </symbol>
  </defs>
</svg>
