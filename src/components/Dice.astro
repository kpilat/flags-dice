---
import { DEFAULT_LANG, MESSAGES } from '../i18n';
import { CATEGORIES } from '../lib/categories';
import { cubeTransform, INITIAL_ROTATION } from '../lib/dice';
import LocalizedText from './LocalizedText.astro';
---

<div
  class="stage"
  id="stage"
  tabindex="0"
  role="button"
  aria-label={MESSAGES[DEFAULT_LANG]['dice.roll']}
>
  <div class="shadow"></div>
  <div class="toss">
    {/* The transform is inline so the CSS minifier cannot rewrite it: the first roll must start
        from matching functions, or browsers interpolate matrices and lose the spins. */}
    <div class="cube" id="cube" style={{ transform: cubeTransform(INITIAL_ROTATION) }}>
      <div class="core c1"></div>
      <div class="core c2"></div>
      <div class="core c3"></div>
      {CATEGORIES.map(({ id, side }) => (
        <div class={`face f-${side}`} data-id={id}>
          <svg aria-hidden="true">
            <use href={`#i-${id}`} />
          </svg>
          <span class="label">
            <LocalizedText message={`category.${id}.name`} />
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .stage {
    --s: min(44vw, 190px);
    position: relative;
    height: calc(var(--s) * 1.9);
    display: grid;
    place-items: center;
    perspective: 900px;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
    border-radius: 20px;
  }

  .stage:focus-visible {
    box-shadow: 0 0 0 3px var(--amber);
  }

  .shadow {
    position: absolute;
    left: 50%;
    bottom: calc(var(--s) * 0.22);
    width: calc(var(--s) * 1.05);
    height: calc(var(--s) * 0.18);
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--shadow), transparent);
    border-radius: 50%;
  }

  .toss {
    transform-style: preserve-3d;
    margin-top: calc(var(--s) * -0.18);
  }

  .cube {
    width: var(--s);
    height: var(--s);
    position: relative;
    transform-style: preserve-3d;
  }

  .cube.rolling {
    transition: transform 1.5s cubic-bezier(0.16, 0.72, 0.22, 1);
  }

  .face,
  .core {
    position: absolute;
    inset: 0;
  }

  .face {
    background: var(--die);
    border-radius: 16%;
    box-shadow:
      inset 0 0 0 1.5px var(--die-edge),
      inset 0 -6px 14px rgba(120, 100, 50, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6%;
    color: var(--amber);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .face svg {
    width: 56%;
    height: 56%;
  }

  .label {
    font: 600 calc(var(--s) * 0.085) / 1 var(--font-lexend);
    color: #3a372e;
    letter-spacing: 0.01em;
    text-align: center;
    padding: 0 8%;
  }

  .core {
    background: var(--die-core);
  }

  .f-front {
    transform: translateZ(calc(var(--s) / 2));
  }
  .f-back {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }
  .f-right {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
  }
  .f-left {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
  }
  .f-top {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
  }
  .f-bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
  }

  .c1 {
    transform: rotateY(90deg) scale(0.97);
  }
  .c2 {
    transform: rotateX(90deg) scale(0.97);
  }
  .c3 {
    transform: scale(0.97);
  }

  .stage.throwing .toss {
    animation: toss 1.5s cubic-bezier(0.3, 0.6, 0.3, 1);
  }

  .stage.throwing .shadow {
    animation: shadow 1.5s cubic-bezier(0.3, 0.6, 0.3, 1);
  }

  @keyframes toss {
    0% {
      transform: translateY(0) scale(1);
    }
    28% {
      transform: translateY(calc(var(--s) * -0.55)) scale(1.12);
    }
    62% {
      transform: translateY(0) scale(1);
    }
    74% {
      transform: translateY(calc(var(--s) * -0.12)) scale(1.02);
    }
    86% {
      transform: translateY(0);
    }
    93% {
      transform: translateY(calc(var(--s) * -0.03));
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes shadow {
    0% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    28% {
      opacity: 0.35;
      transform: translateX(-50%) scale(0.6);
    }
    62% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    74% {
      opacity: 0.8;
      transform: translateX(-50%) scale(0.9);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cube.rolling {
      transition-duration: 0.35s;
    }

    .stage.throwing .toss,
    .stage.throwing .shadow {
      animation: none;
    }
  }
</style>
