---
import { Font, fontData } from 'astro:assets';
import { DEFAULT_LANG, LANG_BY_BROWSER_LANG, LANG_STORAGE_KEY, LANGS } from '../i18n';
import { SITE } from '../lib/site';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const fonts = ['--font-lexend', '--font-figtree'] as const;

// Astro only warns when a font provider fails (e.g. Google Fonts is unreachable during the
// build). Fail the build instead of deploying the page without its fonts.
if (import.meta.env.PROD) {
  const missing = fonts.filter((cssVariable) => !fontData[cssVariable]?.length);
  if (missing.length > 0) {
    throw new Error(`No font files for ${missing.join(', ')}; see the font provider warnings.`);
  }
}
---

<html lang={DEFAULT_LANG} data-ui-lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name}</title>
    <meta name="description" content={SITE.description} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={SITE.themeColor.light}
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={SITE.themeColor.dark} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon-180x180.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    {fonts.map((cssVariable) => (
      <Font cssVariable={cssVariable} preload />
    ))}
    <script
      is:inline
      define:vars={{
        key: LANG_STORAGE_KEY,
        supported: LANGS,
        langByBrowserLang: LANG_BY_BROWSER_LANG,
      }}
    >
      // Pick the language before the first paint (see global.css).
      let lang = null;
      try {
        lang = localStorage.getItem(key);
      } catch {
        // Storage can be blocked.
      }
      if (!supported.includes(lang)) {
        lang = navigator.languages
          .map((tag) => langByBrowserLang[tag.split('-')[0].toLowerCase()])
          .find(Boolean);
      }
      if (lang) {
        document.documentElement.lang = lang;
        document.documentElement.dataset.uiLang = lang;
      }
    </script>
    <script>
      import '../scripts/register-sw';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
